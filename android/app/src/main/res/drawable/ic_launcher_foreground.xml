<?xml version="1.0" encoding="utf-8"?>
<!-- The reader's signature visual: the wordmark's "w" sitting on the RSVP
     focal line, with the ORP guide dashes above and below — the same marks
     the reader draws around the focal word. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Guide dash above. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M47.5,34 L60.5,34" />
    <!-- The w. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M38,46 L45,63 L54,51 L63,63 L70,46" />
    <!-- Guide dash below. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M47.5,74 L60.5,74" />
</vector>
